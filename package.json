{
  "name": "label-checker",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action to check pull requests for labels",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "biome format --write src",
    "check": "biome check src --enforce-assist=false",
    "test": "node --test",
    "test:integration": "INPUT_REPO_TOKEN=${INPUT_REPO_TOKEN:?INPUT_REPO_TOKEN must be set} node --test test/integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "typescript": "^7.0.2"
  }
}
