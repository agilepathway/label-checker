{
  "name": "label-checker",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action to check pull requests for labels",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "biome format --write src",
    "check": "biome check src test .github/actions/semantic-version-tagger/src .github/actions/semantic-version-tagger/spec_impl .github/actions/semantic-version-tagger/spec_test_support --enforce-assist=false",
    "test": "node --test",
    "test:semantic-version-spec": "node --test .github/actions/semantic-version-tagger/spec_impl/semantic-version-tagging.test.ts",
    "test:integration": "INPUT_REPO_TOKEN=\"${GITHUB_TOKEN:-${GH_TOKEN:?GITHUB_TOKEN or GH_TOKEN must be set}}\" TEST_MODE=integration node --test test/check_labels.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  }
}
