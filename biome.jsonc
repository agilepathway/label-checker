{
	"linter": {
		"rules": {
			"complexity": {
				// Cognitive complexity 5 is an empirical starting point intended to provide
				// the same engineering discipline as a McCabe-5 policy, which has served
				// us very well on another project, not a numerical conversion between
				// the two metrics.
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 5
					}
				}
			},
			"suspicious": {
				// Why prevent explicit any? Because any disables type checking. Why
				// prevent disabled checking? Because it hides invalid assumptions. Why
				// avoid hidden assumptions? Because AI-produced code can look valid
				// while failing at runtime. Why require checked types? Because the
				// compiler can then expose those failures before the action runs. Why
				// catch this during linting? Because prevention is cheaper than repair.
				"noExplicitAny": "error",
				// Why prevent evolving types? Because unannotated variables can become
				// any through reassignment. Why avoid evolved any? Because it silently
				// disables type checking. Why is silent loss risky? Because generated
				// code may rely on an accidental type. Why require annotations? Because
				// they make the intended type explicit and reviewable. Why make intent
				// reviewable? Because reviewers can then detect unsafe assumptions.
				"noEvolvingTypes": "error"
			},
			"style": {
				// Why prevent non-null assertions? Because ! overrides nullability
				// checks. Why avoid overridden checks? Because the assertion may be
				// false. Why is a false assertion risky? Because it can cause a
				// runtime failure. Why require proven nullability? Because control
				// flow or explicit handling keeps the safety guarantee in the types.
				// Why preserve that guarantee? Because runtime behavior should match
				// the assumptions checked by TypeScript.
				"noNonNullAssertion": "error",
				// The action runs .ts files directly after erasing types instead of
				// converting them to .js. Enums cannot be erased, so they cannot be
				// used in this codebase.
				"noEnum": "error",
				// noNamespace is stricter than the requirement for erasable TypeScript because
				// it does not distinguish runtime namespaces from type-only namespaces. That's
				// fine for this codebase because the action uses ECMAScript modules instead of
				// namespaces; ECMAScript modules provide the module mechanism we need while
				// keeping the source erasable - so forbidding namespaces entirely is the way to go.
				"noNamespace": "error",
				// The action runs .ts files directly after erasing types instead of converting them to .js. Parameter properties cannot be erased, so they cannot be used in this codebase.
				"noParameterProperties": "error"
			},
			"nursery": {
				// Type assertions can bypass TypeScript's type checking and hide invalid assumptions.
				"noUnsafeTypeAssertion": "error"
			}
		}
	}
}
