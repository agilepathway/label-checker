{
	"linter": {
		"rules": {
			"complexity": {
				// Cognitive complexity 5 is an empirical starting point intended to provide
				// the same engineering discipline as a McCabe-5 policy, which has served
				// us very well on another project, not a numerical conversion between
				// the two metrics.
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 5
					}
				}
			},
			"suspicious": {
				// Explicit any disables type checking and can hide invalid assumptions
				// in AI-produced code; require checked types so the compiler can expose
				// failures before the action runs.
				"noExplicitAny": "error",
				// Unannotated variables can silently evolve into any through
				// reassignment; require explicit intent so reviewers can detect unsafe
				// assumptions in generated code.
				"noEvolvingTypes": "error"
			},
			"style": {
				// Non-null assertions override nullability checks and can cause runtime
				// failures; require control flow or explicit handling so runtime
				// behavior matches TypeScript's assumptions.
				"noNonNullAssertion": "error",
				// The action runs .ts files directly after erasing types instead of
				// converting them to .js. Enums cannot be erased, so they cannot be
				// used in this codebase.
				"noEnum": "error",
				// noNamespace is stricter than the requirement for erasable TypeScript because
				// it does not distinguish runtime namespaces from type-only namespaces. That's
				// fine for this codebase because the action uses ECMAScript modules instead of
				// namespaces; ECMAScript modules provide the module mechanism we need while
				// keeping the source erasable - so forbidding namespaces entirely is the way to go.
				"noNamespace": "error",
				// The action runs .ts files directly after erasing types instead of converting them to .js. Parameter properties cannot be erased, so they cannot be used in this codebase.
				"noParameterProperties": "error"
			},
			"nursery": {
				// Type assertions can bypass TypeScript's type checking and hide invalid assumptions.
				"noUnsafeTypeAssertion": "error"
			}
		}
	}
}
